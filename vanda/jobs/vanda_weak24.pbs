#!/bin/bash -l
#PBS -N km_weak24
#PBS -q auto
#PBS -P personal-zhengkai.ye
#PBS -l select=2:ncpus=12:mpiprocs=12:mem=16gb
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
module load gcc/13.1.0
module load openmpi/gcc/64/4.1.8

MPI_PREFIX=/cm/shared/apps/openmpi4/gcc/4.1.8
OUTDIR="results/vanda/weak_scaling/24_${PBS_JOBID%%.*}"
mkdir -p "$OUTDIR"
HOSTFILE="$OUTDIR/hosts.txt"
sort "$PBS_NODEFILE" | uniq -c | awk '{print $2 " slots=" $1}' > "$HOSTFILE"

if [[ $(wc -l < "$PBS_NODEFILE") -ne 24 || $(wc -l < "$HOSTFILE") -ne 2 ]]; then
  echo "ERROR: Expected 24 MPI slots across 2 distinct nodes" >&2
  exit 1
fi

echo "=== Allocated hosts ==="
cat "$HOSTFILE"
echo "=== MPI rank placement ==="
mpiexec --prefix "$MPI_PREFIX" -np 24 --hostfile "$HOSTFILE" \
  --map-by ppr:12:node --bind-to core hostname | sort | uniq -c | tee "$OUTDIR/rank_placement.txt"

ARGS=(--points 19200000 --clusters 8 --dims 8 --iterations 20 --seed 1234)
run_mpi() {
  mpiexec --prefix "$MPI_PREFIX" -np 24 --hostfile "$HOSTFILE" \
    --map-by ppr:12:node --bind-to core ./bin/mpi "${ARGS[@]}"
}

echo "=== Warm-up (not measured) ==="
run_mpi > "$OUTDIR/warmup.log" 2>&1

echo "=== Five timed repetitions ==="
for rep in 1 2 3 4 5; do
  echo "Measurement $rep"
  run_mpi 2>&1 | tee "$OUTDIR/rep_${rep}.log"
done

python3 - "$OUTDIR" <<'PY'
import csv
import pathlib
import statistics
import sys

out = pathlib.Path(sys.argv[1])
fields = ["variant", "points", "clusters", "dims", "iterations", "ranks",
          "threads", "time_s", "communication_s", "inertia", "accuracy",
          "assignment_hash"]
rows = []
for rep in range(1, 6):
    filename = out / ("rep_{}.log".format(rep))
    matches = [line for line in filename.read_text(errors="replace").splitlines()
               if line.startswith("RESULT ")]
    if len(matches) != 1:
        raise RuntimeError("Expected one RESULT in {}, found {}".format(filename, len(matches)))
    values = dict(part.split("=", 1) for part in matches[0].split()[1:])
    if (values.get("variant") != "mpi" or values.get("ranks") != "24" or
            values.get("points") != "19200000" or
            values.get("iterations") != "20" or
            float(values.get("accuracy", "0")) < 0.999999):
        raise RuntimeError("Unexpected result or incorrect assignments in {}".format(filename))
    rows.append({"source": str(filename), **values})
if len({row["assignment_hash"] for row in rows}) != 1:
    raise RuntimeError("Assignment hashes differ between repetitions")
with (out / "results.csv").open("w", newline="") as f:
    w = csv.DictWriter(f, fieldnames=["source"] + fields)
    w.writeheader()
    w.writerows(rows)
times = [float(row["time_s"]) for row in rows]
print("VALIDATION PASSED: five runs with matching assignment hashes")
print("Median runtime: {:.6f} s".format(statistics.median(times)))
print("Min/max runtime: {:.6f}/{:.6f} s".format(min(times), max(times)))
print("Saved:", out / "results.csv")
PY
