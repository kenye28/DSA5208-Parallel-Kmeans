#!/bin/bash -l
#PBS -N km_gpu_probe
#PBS -q auto
#PBS -P personal-zhengkai.ye
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

OUTDIR="results/vanda/gpu_probe/${PBS_JOBID%%.*}"
mkdir -p "$OUTDIR"

echo "=== Compute node ==="
hostname

echo "=== GPU allocation ==="
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-not-set}"

echo "=== NVIDIA GPUs ==="
nvidia-smi -L | tee "$OUTDIR/gpu_list.txt"

echo "=== GPU specifications ==="
nvidia-smi --query-gpu=name,memory.total,driver_version \
  --format=csv | tee "$OUTDIR/gpu_specs.csv"

echo "=== CUDA toolkit ==="
module load cuda12.4/toolkit/12.4.1

which nvcc
nvcc --version | tee "$OUTDIR/cuda_version.txt"

echo "=== GPU diagnostic completed successfully ==="
