#!/bin/bash
#PBS -N km_hyb16m
#PBS -q parallel
#PBS -l walltime=00:35:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit with qsub from the project root}"
source scripts/atlas8_env.sh

LIBSTDCPP=$(g++ -print-file-name=libstdc++.so.6)
[[ -f "$LIBSTDCPP" ]] || { echo 'ERROR: GCC libstdc++ not found' >&2; exit 1; }
export LD_LIBRARY_PATH="$(dirname "$LIBSTDCPP"):${LD_LIBRARY_PATH:-}"

[[ -x bin/mpi && -x bin/mpi_openmp ]] || { echo 'ERROR: missing compiled binaries' >&2; exit 1; }
OUTDIR="results/atlas8/hybrid_compare16m/${PBS_JOBID%%.*}"
mkdir -p "$OUTDIR"
HOSTFILE="$OUTDIR/mpi_hosts.txt"
sort "$PBS_NODEFILE" | uniq -c | awk '{printf "%s slots=%d\n", $2, $1}' > "$HOSTFILE"
SLOTS=$(wc -l < "$PBS_NODEFILE")
[[ "$SLOTS" -ge 12 ]] || { echo "ERROR: need 12 PBS slots, got $SLOTS" >&2; exit 1; }
{
  echo "job_id=${PBS_JOBID}"
  echo "slots=$SLOTS"
  echo 'fixed_dataset_points=16000000'
  echo 'cases=mpi12,hyb6x2,hyb3x4,omp1x12'
  date -Is
  cat "$HOSTFILE"
} > "$OUTDIR/run_metadata.txt"

ARGS=(--points 16000000 --clusters 8 --dims 8 --iterations 20 --seed 1234)
labels=(mpi12 hyb6x2 hyb3x4 omp1x12)
for label in "${labels[@]}"; do
  : > "$OUTDIR/$label.log"
done

run_case() {
  local label="$1" rep="$2" ranks threads exe
  case "$label" in
    mpi12) ranks=12; threads=1; exe=./bin/mpi ;;
    hyb6x2) ranks=6; threads=2; exe=./bin/mpi_openmp ;;
    hyb3x4) ranks=3; threads=4; exe=./bin/mpi_openmp ;;
    omp1x12) ranks=1; threads=12; exe=./bin/mpi_openmp ;;
    *) echo "Invalid case $label" >&2; exit 1 ;;
  esac
  export OMP_NUM_THREADS="$threads" OMP_DYNAMIC=FALSE
  export OMP_PLACES=cores OMP_PROC_BIND=close
  echo "=== $label repetition=$rep (0 is warm-up) ==="
  local -a CMD
  CMD=(mpiexec --prefix /app1/centos7/gnu/openmpi-4.1.2_install
       --hostfile "$HOSTFILE" --map-by "slot:PE=${threads}" --bind-to core
       -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x OMP_DYNAMIC
       -x OMP_PLACES -x OMP_PROC_BIND -np "$ranks" "$exe")
  if (( rep == 0 )); then
    "${CMD[@]}" "${ARGS[@]}" > /dev/null
  else
    "${CMD[@]}" "${ARGS[@]}" | tee -a "$OUTDIR/$label.log"
  fi
}

# Rotate order to reduce systematic thermal/placement timing bias.
for rep in 0 1 2 3 4 5; do
  for offset in 0 1 2 3; do
    index=$(((rep + offset) % 4))
    run_case "${labels[index]}" "$rep"
  done
done
python3 scripts/parse_results.py "$OUTDIR"/*.log > "$OUTDIR/results.csv"
python3 scripts/summarize_csv.py "$OUTDIR/results.csv"
echo "Saved: $OUTDIR/results.csv"
